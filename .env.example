# ---------------------------------------------------------------------------
# Copier ce fichier en `.env` puis renseigner les valeurs.
# Aucune valeur de ce fichier ne doit être un secret réel : il est versionné.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# URL publique de l'app, sans slash final. Sert aux liens d'email, aux
# callbacks OAuth et aux balises Open Graph.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Base de données -------------------------------------------------------
# PostgreSQL 15+. Le `schema=public` est requis par Prisma.
DATABASE_URL="postgresql://astra:astra@localhost:5432/astra_biolink?schema=public"

# --- Redis -----------------------------------------------------------------
# Sert au cache des pages publiques, au rate limiting et à la révocation
# de sessions. En local : `docker run -p 6379:6379 redis:7-alpine`.
REDIS_URL="redis://localhost:6379"

# --- Secrets JWT -----------------------------------------------------------
# Générer chacun avec : openssl rand -base64 48
# Deux secrets distincts : compromettre l'access token ne doit pas permettre
# de forger un refresh token.
JWT_ACCESS_SECRET="remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum"
JWT_REFRESH_SECRET="remplacer-par-une-autre-valeur-aleatoire-differente-de-la-precedente"

# Durées de vie. L'access token est volontairement court : la révocation
# d'une session distante ne prend effet qu'à son expiration.
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"

# Chiffrement des secrets TOTP stockés en base (AES-256-GCM).
# Générer avec : openssl rand -base64 32
# Un secret TOTP en clair dans la base rendrait la 2FA inutile en cas de
# fuite : l'attaquant générerait les codes lui-même.
# ⚠ Perdre cette clé rend la 2FA de tous les comptes indéchiffrable.
ENCRYPTION_KEY="remplacer-par-32-octets-en-base64-voir-commande-ci-dessus"

# --- Stockage des médias ---------------------------------------------------
# "local" : fichiers écrits sur le disque du serveur (dev, petite instance),
# servis par /api/media/file. Aucune infra externe requise.
# "s3"    : bucket compatible S3 (production à l'échelle). Renseigner alors
#           les variables S3_* ci-dessous.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR=".uploads"

# --- Stockage S3 (requis seulement si STORAGE_DRIVER=s3) --------------------
# Compatible AWS S3, Backblaze B2 (recommandé), MinIO.
# Backblaze B2 : bucket privé + clés d'application avec accès S3 API.
#   S3_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
#   S3_REGION="eu-central-003" (région du bucket, présente dans l'URL de l'endpoint)
#   S3_PUBLIC_HOST="nom-bucket.s3.eu-central-003.backblazeb2.com"
#   S3_FORCE_PATH_STYLE="false"
S3_ENDPOINT="https://s3.eu-west-3.amazonaws.com"
S3_REGION="eu-west-3"
S3_BUCKET="astra-biolink-media"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Nom d'hôte public du bucket ou du CDN devant (sans protocole).
# Doit correspondre à `images.remotePatterns` dans next.config.ts.
S3_PUBLIC_HOST="astra-biolink-media.s3.eu-west-3.amazonaws.com"
# Base URL complète du CDN médias (ex. https://media.astra.is-a.dev). Définie
# quand un CDN avec cache (Cloudflare Pages + fonction, voir cloudflare/)
# sert les fichiers devant le bucket : les nouvelles URLs de médias pointent
# dessus, et l'ancienne route proxy redirige vers lui. Absente = les médias
# continuent d'être servis par le proxy de l'application.
S3_PUBLIC_URL="https://media.astra.is-a.dev"
# Requis pour MinIO, à laisser "false" pour AWS S3 et Backblaze B2.
S3_FORCE_PATH_STYLE="false"

# --- Email (vérification, reset mot de passe, suspensions) -----------------
# En développement, laisser SMTP_HOST vide : les emails sont alors écrits
# dans la console au lieu d'être envoyés.
#
# Chaque envoi est tracé dans la table `email_logs` (panel admin → Emails) :
# destinataire, type, statut, erreur éventuelle. Aucun token ni contenu
# sensible n'y est stocké.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Astra <noreply@astra.is-a.dev>"

# --- OAuth Discord ---------------------------------------------------------
# https://discord.com/developers/applications → OAuth2
# Redirect URI à déclarer : {NEXT_PUBLIC_APP_URL}/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# --- Sécurité --------------------------------------------------------------
# Nombre d'échecs de login avant exigence d'un captcha sur l'identifiant.
LOGIN_ATTEMPTS_BEFORE_CAPTCHA="5"
# hCaptcha ou Turnstile. Laisser vide désactive le captcha (dev uniquement).
CAPTCHA_SECRET_KEY=""
NEXT_PUBLIC_CAPTCHA_SITE_KEY=""

# --- Bootstrap admin -------------------------------------------------------
# Le seed (`npm run db:seed`) crée ce compte avec le rôle admin.
# À changer immédiatement après le premier login.
SEED_ADMIN_EMAIL="admin@astra.is-a.dev"
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="ChangeMoi!2026"
